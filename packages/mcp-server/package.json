{
  "name": "@marionette/mcp-server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Viral Ventures LLC (Maple Grove, MN)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "marionette-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "reference": "node generate-reference.mjs",
    "reference:check": "node generate-output-schemas.mjs --check && node generate-reference.mjs --check",
    "outputs": "node generate-output-schemas.mjs"
  },
  "dependencies": {
    "@marionette/atlas-pack": "workspace:*",
    "@marionette/document-core": "workspace:*",
    "@marionette/format": "workspace:*",
    "@marionette/import-spine": "workspace:*",
    "@marionette/render-preview": "workspace:*",
    "@marionette/runtime-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "jose": "6.2.3",
    "pngjs": "^7.0.0",
    "stripe": "22.6.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "esbuild": "0.28.2",
    "vitest": "4.1.11"
  }
}
